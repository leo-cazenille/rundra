    "run": {"positionals": ["experiment"], "options": ["--config", "--confirm-tasks", "--data-dir", "--destination", "--fetch-mode", "--json", "--offline", "--prepare-location", "--profile", "--progress", "--progress-interval", "--project-file", "--random-seed", "--rebuild", "--rebuild-image", "--seed", "--seeds", "--source-root", "--target", "--targets-file", "--task-slots-per-worker", "--verbose", "--workers"]},
