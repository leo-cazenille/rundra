{
  "format_version": 6,
  "program": "rundr",
  "global_options": ["--json"],
  "commands": {
    "validate": {"positionals": ["experiment"], "options": ["--json"]},
    "plan": {"positionals": ["experiment"], "options": ["--config", "--execution-strategy", "--json", "--offline", "--prepare-location", "--profile", "--project-file", "--random-seed", "--rebuild", "--retrieval", "--seed", "--seeds", "--source-root", "--target", "--targets-file"]},
    "targets": {"positionals": [], "options": ["--json", "--targets-file"]},
    "doctor": {"positionals": ["experiment"], "options": ["--connect", "--json", "--profile", "--project-file", "--target", "--targets-file"]},
    "run": {"positionals": ["experiment"], "options": ["--config", "--data-dir", "--destination", "--json", "--offline", "--prepare-location", "--profile", "--progress", "--project-file", "--random-seed", "--rebuild", "--seed", "--seeds", "--source-root", "--target", "--targets-file", "--verbose"]},
    "submit": {"positionals": ["experiment"], "options": ["--config", "--data-dir", "--destination", "--json", "--offline", "--prepare-location", "--profile", "--progress", "--project-file", "--random-seed", "--rebuild", "--seed", "--seeds", "--source-root", "--target", "--targets-file", "--verbose"]},
    "status": {"positionals": ["run_id"], "options": ["--data-dir", "--json"]},
    "tasks": {"positionals": ["run_id"], "options": ["--data-dir", "--json", "--limit", "--offset"]},
    "list": {"positionals": [], "options": ["--data-dir", "--json"]},
    "logs": {"positionals": ["run_id"], "options": ["--data-dir", "--json", "--preparation", "--task"]},
    "fetch": {"positionals": ["run_id"], "options": ["--data-dir", "--destination", "--extract", "--json", "--mode", "--task"]},
    "inspect": {"positionals": ["run_id"], "options": ["--data-dir", "--json"]},
    "cancel": {"positionals": ["run_id"], "options": ["--data-dir", "--json"]},
    "purge": {"positionals": ["run_id"], "options": ["--confirm", "--data-dir", "--dry-run", "--json", "--workspace"]}
  }
}
